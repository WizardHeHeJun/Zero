+def _fold_blank_durations(symbols, frame_counts, blank="_"):
+    """Zero 口型 v2 契约：把 blank 帧数折叠进相邻真实音素（不向下游泄漏 blank 语义）。
+
+    每段连续 blank 的总帧数并入**紧随其后**的真实音素；序列末尾的 blank 游程没有
+    “后一个”真实音素可并，改并入**前一个**（README 记录方向——纯粹是残余时长的
+    归属选择，与协同发音前移无关）。长度不匹配（对齐失败）一律返回 (None, None)，
+    交调用方整段不发头。
+    """
+    if len(symbols) != len(frame_counts):
+        return None, None
+    real_symbols = []
+    real_durations = []
+    pending_blank = 0
+    for symbol, count in zip(symbols, frame_counts):
+        if symbol == blank:
+            pending_blank += count
+            continue
+        real_symbols.append(symbol)
+        real_durations.append(count + pending_blank)
+        pending_blank = 0
+    if pending_blank:
+        if not real_durations:
+            return None, None  # 整句全 blank（异常输入），不构造空音素表
+        real_durations[-1] += pending_blank
+    return real_symbols, real_durations
+
