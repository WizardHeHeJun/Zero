# ── Secrets / 本地配置 ─────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*.crt
secrets/

# ── Harness / 知识框架（按用户决定: 不纳入版本控制）─────
# 这些是自用的 Claude Code harness 与知识路由/文档, 属脚手架而非项目产物;
# 只让未来的 src/ 、tests/ 进版本库。
# 注意: gitignore 仅表示"不进 git、不随仓库共享", 本地仍直接从磁盘读取, 功能不受影响。
# (本段覆盖了早先"`.claude/` harness 资产必须提交"的约定)
.claude/
ai-docs/
ai-shared/
evals/
PRP/
/CLAUDE.md
# 注: notes/(研究笔记) 与 diagrams/(架构图产物) 仅本地维护, 不随仓库共享。
notes/
diagrams/

# ── 知识交接（本地，用户自行维护，不上 GitHub）──────
/HANDOFF.md
# PROGRESS.md 是本地工程进度记录, 仅本地维护, 不随仓库共享。
/PROGRESS.md

# ── Python ────────────────────────────────────────
# 注意: uv.lock 应当提交(锁定依赖), 不要在此忽略。
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# ── Node / TypeScript ─────────────────────────────
node_modules/
*.tsbuildinfo
.npm/
.pnpm-store/
coverage/

# ── 数据 / 本地服务 ────────────────────────────────
*.sqlite
*.db
pgdata/
neo4j_data/
redis_data/
*.dump
# data/ 是本地用户数据(库文件/数据集/缓存), 不进版本库
data/*
# personas/ 放人格卡: *.example.json 模板随仓库共享; 个人真实人格(*.json)不进版本库, 可放多份随时切换(改 ZERO_PERSONA_FILE 指向)
personas/*.json
!personas/*.example.json
artifacts/

# ── 日志 / 临时 ────────────────────────────────────
logs/
*.log
*.tmp

# ── 编辑器 / 系统 ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
