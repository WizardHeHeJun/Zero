# Zero 环境变量样例（复制为 .env 后按需改）。读法/必填项/旋钮说明见 README「配置（.env）」。
# 不设任何变量 = 全内存占位、零依赖可跑。⚠ 每个 KEY 只能出现一次（dotenv 后者覆盖前者）。

# ── 运行后端（下面赋值均为默认；想落盘/接真库才改）──
ZERO_CHECKPOINT_BACKEND=memory                  # memory / sqlite / postgres
ZERO_CHECKPOINT_DB=data/checkpoints.sqlite3
ZERO_PG_DSN=postgresql://postgres:postgres@localhost:5432/zero
ZERO_MEMORY_BACKEND=memory                      # memory / sqlite / neo4j(需 db extra)
ZERO_GRAPH_DB=data/graph.sqlite3
ZERO_NEO4J_URI=bolt://localhost:7687            # 下 3 项：MEMORY=neo4j 或 Graphiti 用 neo4j 时生效
ZERO_NEO4J_USER=neo4j
ZERO_NEO4J_PASSWORD=password

# ── LLM（OpenAI 兼容；语言层 + 语义 embedding 共用）──
ZERO_OPENAI_API_KEY=sk-your-key-here            # 必填
ZERO_OPENAI_MODEL=qwen-flash                    # 必填，key 有权限的真实模型 id
ZERO_OPENAI_BASE_URL=https://api.openai.com/v1  # 可选；留空用 SDK 默认

# ── 语义记忆侧信道（向量召回）──
ZERO_SEMANTIC_BACKEND=sqlite_vec                # 关 / sqlite_vec(--chat 默认开) / graphiti
ZERO_GRAPHITI_EMBED_MODEL=gemini-embedding-001  # 嵌入模型(sqlite_vec/graphiti 都用)
ZERO_GRAPHITI_MODEL=deepseek-v4-pro             # 仅 graphiti 抽取用
ZERO_GRAPHITI_DB=neo4j                          # 仅 graphiti 图库，复用 NEO4J_*

# ── 文本情感回归（输入侧·默认关；置 st 须同时给权重路径）──
# ZERO_TEXT_AFFECT_BACKEND=st
# ZERO_TEXT_AFFECT_MODEL_PATH=artifacts/text_affect_regressor_st.pt

# ══ 可选旋钮：默认注释 = 用内置默认；取消注释才覆盖（⭐=数字人推荐）══

# ── 数字人对话：人格 + 情绪读出/修复 ──
# ZERO_PERSONA_FILE=data/persona.json  # ⭐人格卡，治"编造关系"(模板 persona.example.json)
# ZERO_AFFECT_READOUT=map              # ⭐map=后验均值(消情绪标签翻号) / sample=采样(默认)
# ZERO_APPRAISE_CALIBRATE=1            # 评价标定抵消 LLM 正向偏置；强模型可不开
# ZERO_EMOTION_NOISE_STD=0.05          # 情绪噪声幅度；调小=更稳、0=关
# ZERO_SAMPLE_SIGMA_MAX=0.5            # 采样抖动上限；仅 sample 读出下生效
# ZERO_CHAT_RNG_SEED=42                # 固定种子(eval 复现用；日常留注释)
# ZERO_EMOTION_BASELINE_ATTITUDE_W=0.6 # 情绪回落基线 attitude 占比；<1 防越聊越上头

# ── 记忆：注意力窗 + 召回排序（默认已调好，一般不动）──
# ZERO_HISTORY_WINDOW=40               # 工作记忆窗总条数(首因+近因)
# ZERO_HISTORY_PRIMACY_K=5             # 窗内首因保留条数
# ZERO_RECALL_INJECT_MIN=0.5           # 召回升入注意力预算的重要性门 ∈[0,1]
# ZERO_RECALL_SIM_MIN=0.65             # 召回余弦相似度下限
# ZERO_RECALL_DECAY_D=0.5              # recency 幂律指数 d
# ZERO_RECALL_ALPHA=0.33               # 三维重排权重：recency
# ZERO_RECALL_BETA=0.34                # 三维重排权重：sim
# ZERO_RECALL_GAMMA=0.33               # 三维重排权重：importance
# ZERO_RECALL_IMPORTANCE_SCALE=30      # importance 归一 Hill 常数 C
# ZERO_RECALL_AROUSAL_MOD=0            # 唤醒调制召回 importance(1 开启)
# ZERO_EPISODE_MAX_PER_KEY=300         # 单人情景上限(0=不限；--chat 默认 300)
# ZERO_EPISODE_SALIENCE_MIN=0.15       # 情景写入显著度门
# ZERO_EPISODE_SALIENCE_AFFECTIVE_ADD=0  # 低唤醒高语义补偿(1 开启)
# ZERO_EPISODE_DEDUP_MAX=0.92          # 情景写入去重余弦阈

# ── 日志：带对话内容的可读日志（默认开）──
# ZERO_CONVERSATION_LOG=1              # 每轮对话落 logs/conversation-*.log(user/reply 原文+引擎 trace)；0=关
# ZERO_LOG_DIR=logs                    # 日志目录(通用 app 日志与对话日志共用)
