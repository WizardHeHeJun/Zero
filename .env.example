# Zero 环境变量样例（复制为 .env 后按需改）。每个变量只给一行功能速记；
# 读法 / 默认值 / 推荐值 / 取值范围 / 依据一律见 README「配置（.env）」。
# 不设任何变量 = 全内存占位、零依赖可跑。⚠ 每个 KEY 只能出现一次（dotenv 后者覆盖前者）。

# ── 运行后端 ──
ZERO_CHECKPOINT_BACKEND=memory                  # 运行态后端：memory / sqlite / postgres
ZERO_CHECKPOINT_DB=data/checkpoints.sqlite3     # sqlite 后端库文件路径
ZERO_PG_DSN=postgresql://postgres:postgres@localhost:5432/zero  # postgres 后端 DSN
ZERO_MEMORY_BACKEND=memory                      # 长期记忆图谱：memory / sqlite / neo4j
ZERO_GRAPH_DB=data/graph.sqlite3                # sqlite 图谱库文件路径
ZERO_NEO4J_URI=bolt://localhost:7687            # neo4j 连接 URI
ZERO_NEO4J_USER=neo4j                           # neo4j 用户名
ZERO_NEO4J_PASSWORD=password                    # neo4j 密码

# ── LLM（OpenAI 兼容；语言层 + 语义 embedding 共用）──
ZERO_OPENAI_API_KEY=sk-your-key-here            # 必填：API key
ZERO_OPENAI_MODEL=qwen-flash                    # 必填：key 有权限的真实模型 id
ZERO_OPENAI_BASE_URL=https://api.openai.com/v1  # 可选：接口地址（留空用 SDK 默认）

# ── 语义记忆侧信道（向量召回）──
ZERO_SEMANTIC_BACKEND=sqlite_vec                # 关 / sqlite_vec / graphiti
ZERO_GRAPHITI_EMBED_MODEL=gemini-embedding-001  # 向量嵌入模型
ZERO_GRAPHITI_MODEL=deepseek-v4-pro             # graphiti 抽取用 LLM
ZERO_GRAPHITI_DB=neo4j                          # graphiti 图库（复用 NEO4J_*）

# ── 文本情感回归（输入侧·默认关）──
# ZERO_TEXT_AFFECT_BACKEND=st                    # 改用训练好的回归头（须同时给权重路径）
# ZERO_TEXT_AFFECT_MODEL_PATH=artifacts/text_affect_regressor_st.pt  # 回归头权重路径

# ══ 可选旋钮：注释 = 用内置默认；取消注释才覆盖 ══
# 数字人对话/记忆组已直接给推荐值（复制即数字人推荐配置）；研究级组保持注释=默认关=行为不变。

# ── 数字人对话：人格 + 情绪读出/修复 ──
# ZERO_PERSONA_FILE=personas/persona.json       # 人格卡文件路径
ZERO_AFFECT_READOUT=map                         # 情绪读出：map=后验均值 / sample=采样
ZERO_APPRAISE_CALIBRATE=1                        # 评价标定，抵消 LLM 正向偏置
ZERO_EMOTION_NOISE_STD=0.05                      # 情绪噪声幅度（0=关）
ZERO_EMOTION_BASELINE_ATTITUDE_W=0.6            # 情绪回落基线里 attitude 占比
# ZERO_SAMPLE_SIGMA_MAX=0.5                      # 采样抖动上限（仅 sample 读出）
# ZERO_CHAT_RNG_SEED=42                          # 固定随机种子（eval 复现）

# ── 数字人对话：治「越聊越暧昧」──
ZERO_INTENSITY_FLOOR=0                           # arousal 强度下限
ZERO_AROUSAL_BASELINE=-0.08                      # arousal 基准平移
ZERO_ATTITUDE_REVERSION_A=0.4                    # 态度 arousal 维回归率
ZERO_ATTITUDE_SETPOINT_A=0.0                     # 态度 arousal 回归锚
ZERO_HABITUATION_TAU=7                           # 习惯化 τ(轮)；空/0=关

# ── 数字人对话：防关系无端升温 ──
ZERO_AROUSAL_GAIN_CAP=0.5                        # arousal_gain 上限；空=不 cap
ZERO_ATTITUDE_RATE_DECAY_K=0.8                   # 越熟态度形成越慢；0=关
ZERO_FAMILIARITY_TAU=20                          # 熟悉度累积 τ(轮)；仅 K>0 生效
ZERO_RELATIONSHIP_STAGE_HINT=1                   # 关系距离软提示；空/0=关

# ── 记忆：注意力窗 + 召回排序 ──
ZERO_HISTORY_WINDOW=40                           # 工作记忆窗总条数
ZERO_HISTORY_PRIMACY_K=5                         # 窗内首因保留条数
ZERO_RECALL_INJECT_MIN=0.5                       # 召回升入注意力预算的重要性门
ZERO_RECALL_SIM_MIN=0.65                         # 召回余弦相似度下限
ZERO_RECALL_DECAY_D=0.5                          # recency 幂律指数 d
ZERO_RECALL_ALPHA=0.33                           # 三维重排权重：recency
ZERO_RECALL_BETA=0.34                            # 三维重排权重：sim
ZERO_RECALL_GAMMA=0.33                           # 三维重排权重：importance
ZERO_RECALL_IMPORTANCE_SCALE=30                  # importance 归一 Hill 常数 C
ZERO_RECALL_AROUSAL_MOD=0                        # 唤醒调制召回 importance（1 开启）
ZERO_EPISODE_MAX_PER_KEY=300                     # 单人情景上限（0=不限）
ZERO_EPISODE_SALIENCE_MIN=0.15                   # 情景写入显著度门
ZERO_EPISODE_SALIENCE_AFFECTIVE_ADD=0           # 低唤醒高语义补偿（1 开启）
ZERO_EPISODE_DEDUP_MAX=0.92                      # 情景写入去重余弦阈

# ── workspace 精度重构（默认注释=关，行为不变）──
# ZERO_PRECISION_SPLIT=1                         # value 流精度用 precision_da 消 β·V 混同
# ZERO_FUSE_INDEPENDENCE_CORRECT=1               # value 流 valence 维精度置极小防共线过度自信
# ZERO_IGNITION_SURVIVAL_FALLBACK=1              # 全弱刺激时 survival 流兜底广播
# ZERO_IGNITION_BETA=20                          # ignite 软门控陡度 β；注释=硬 step（默认行为）

# ── va_coupling 非对称（也可在 persona JSON 配，persona 优先；默认注释=对称 0.6，行为不变）──
# ZERO_VA_COUPLING_POS=0.5                       # 正效价侧 V-A 耦合系数
# ZERO_VA_COUPLING_NEG=0.7                       # 负效价侧 V-A 耦合系数

# ── 两时间尺度补充（默认注释=关，行为不变）──
# ZERO_ATTITUDE_AROUSAL_WEIGHT=0.0               # 高唤醒 stimulus 放大态度累积率；0=关
# ZERO_HABITUATION_SENSITIZATION_GAIN=0.0        # 习惯化+敏化双过程敏化增益；0=纯习惯化
# ZERO_SENSITIZATION_THRESHOLD=0.5               # 敏化激活阈

# ── OCC 评价补充（默认注释=关，行为不变）──
# ZERO_STANDARD_COMPLIANCE=1                     # 词典桥读社会规范违反/遵从，通电 OCC 分支 B

# ── Panksepp RAGE/FEAR 次级区分（缺神经生理依据，建议保持关闭）──
# ZERO_PANKSEPP_DISTINGUISH_FEAR=1               # (-v,+a) 象限按 arousal 阈值分 fear/rage

# ── coping_potential 独立标量流（议会 2026-07-13，默认关=零回归）──
# (-v,+a) 象限用 control_appraisal（情境控制感）分离 rage/fear；阈值 ±0.3 待 P1 观测校准
# ZERO_COPING_POTENTIAL_ENABLED=false

# ── fear 域专属门（议会 2026-07-21·B1 BLOCK 前置·WARN-3；默认关=零回归）──
# False（默认）→ 任何路径不产 fear 域激活（survival_narrative 域 text_coping_prior 硬弃·
# motivational_system coping<阈值分支返回 rage 保守默认）；anger confrontational 路径不受此门。
# True → 解除硬弃，须确保 fear 生产解锁前置（第二生存叙事源 LB≥0.80）。
# ZERO_FEAR_DOMAIN_ENABLED=false

# ── live-chat 域注入（议会 2026-07-21·A+D 底座·opt-in；默认关=零回归）──
# chat_driver 每轮词典桥判 confrontational/None 注入 Stimulus.domain；
# 开启前须完成：confrontational 留出集 Wilson LB precision>=0.53 实测
# （B-domain-holdout·未做·勿生产依赖）。
# 仅产二值（confrontational/None），不产 survival_narrative（36pp 悬崖·BLOCK）。
# 开启后配合 ZERO_TEXT_COPING_ENABLED=true 使 live-chat 享域条件化保护
# （仅 confrontational 域 anger 生效）。
# ZERO_TEXT_DOMAIN_ENABLED=false

# ── text_coping 接线旋钮（议会 2026-07-20·域条件化解锁·opt-in；默认关=零回归）──
# 方向门(SemEval confrontational anger Wilson LB=0.857)+独立性门(r(V,D)=-0.031)均过→
# confrontational 域内解锁依据充分（非全域无条件·ED 叙事域 anger 0.68 仍 FAIL；见
# notes/2026-07-20-anger-unlock-decision-council.md）。W1 PerceptionAgent 接线已落地(145fea6)。
# 域条件化=调用方每轮注入 domain（perception.py B2 域门：domain="confrontational" 才接受 anger·
# survival_narrative/neutral/失配硬弃·domain=None 整门旁路=全域生效）。
# ⚠ 启用面差异（anger confrontational 域解锁 2026-07-21 产品拍板启用；启用须在运行 .env 设值）：
#   · MCP 面（域条件化正解·就绪）：设 ZERO_MCP_TEXT_COPING_ENABLED=true + 下方 MODEL_PATH(_m 主权重)·
#     client payload 传 domain="confrontational"+coping_potential≥0 → 仅 confrontational×anger 生效。
#   · chat 面：须同时设 ZERO_TEXT_DOMAIN_ENABLED=true（上方）使 chat_driver 注入 domain；
#     两者同开→ live-chat 域条件化正解（仅 confrontational×anger）。
# ZERO_TEXT_COPING_ENABLED=false
# ZERO_TEXT_COPING_PRECISION=0.08   # 单一 π_t<=0.10；精度分设(anger0.07/fear0.15)待 W1/第二源后
# W1 PerceptionAgent 接线旋钮（须同时设 ENABLED + MODEL_PATH 方生效）：
# ZERO_DIRECTION_HEAD_MODEL_PATH=artifacts/motivational_direction_prior_m.pt
#   # DirectionHead 主权重(_m·符号监督·含 CC BY-NC 按 Research-Only)；未设=不加载=text_coping_prior 恒 None
# ZERO_ANGER_ABSTAIN_LOGIT_THRESHOLD=0.0
#   # 弃权门阈值 τ；默认 0.0=不弃权（旋钮 inert·议会 B1 保留）；激活须独立 confrontational 留出集重 calibrate

# ── FacsDecoder AU 扩展（设计门 2026-07-13·路径 b；默认关=零回归）──
# 开启后表情通道用 11-AU 集合，据 coping_potential 分区分愤怒(AU23)/恐惧(AU01/02/20)
# ZERO_FACS_EXTENDED=false

# ── 真表情解码器注入（composite 工厂接线 2026-07-14；默认注释=占位路径零回归）──
# 设权重路径 → chat 工厂加载真 FacsDecoder 并构造 CompositeChannelDecoder 作 expression_decoder；
# 未设 → decoder=None → 解析占位路径（逐字旧行为）。权重形状须与 ZERO_FACS_EXTENDED 配对：
# true ↔ facs_decoder_ext.pt(11 AU) / false ↔ expression_decoder.pt(5 AU)，不配对加载即 fail-fast。
# ZERO_FACS_MODEL_PATH=artifacts/facs_decoder_ext.pt
# AU 映射幅度系数 k_arousal/k_coping（⚖ 方向议会定、仅幅度可调）：占位路径用 decode_channels
# 内置默认(1.5/1.2)；注入 composite 时经下面两个 env 构造期读入（不为系数拉 state 字段）。
# ZERO_FACS_K_AROUSAL=1.5
# ZERO_FACS_K_COPING=1.2

# ── 双通路差异化：随意头 coping 泄漏系数（议会 C1 设计门 2026-07-14）∈[0,1]──
# 自发头(push)全量传 coping、随意头(pull·意志调控)传 coping×leak（意志部分压制 coping-driven AU，
# Rinn 1984）。默认 1.0=两头等值=零回归；推荐 0.3（随意头保留自发头 30% coping 强度）。
# 仅 ZERO_FACS_EXTENDED=true 时对 facs_au 生效。
# ZERO_VOLUNTARY_COPING_LEAK=1.0

# ── C2 residual 叠加：注入真 FacsDecoder 时 coping 判别 AU 的混合系数（议会 C2 设计门）∈[0,1]──
# 真模型出通用 AU 基准（从真脸学喜/悲/惊…），coping 判别 AU（AU23/01/02/20）= base*(1-α)+占位coping*α。
# 默认 1.0=判别 AU 纯占位（保愤怒/恐惧分野）+ 其余 AU 用真模型；0=全用真模型（丢分野）。
# 仅在注入真 FacsModel（经 ZERO_FACS_MODEL_PATH）且 ZERO_FACS_EXTENDED=true 时生效；
# 未设 MODEL_PATH（占位路径）时本变量不被读取、设了也无效果。
# ZERO_FACS_RESIDUAL_ALPHA=1.0

# ── 真韵律解码器注入（zero-link T4·2026-07-22；默认注释=占位路径·prosody_scale=ratio 零回归）──
# 设权重路径 → 工厂加载真 ProsodyDecoder 注入 CompositeChannelDecoder 的 prosody 通道，prosody_scale
# 由 "ratio"（解析占位·倍率口径）翻为 "normalized"（三值归一 [0,1]·sigmoid），供 MCP 情感 TTS mapper
# 按 normalized 分支线性映射。未设 → prosody 走解析占位（ratio·零回归）。与 FACS 独立：可单独设本项
# 而不设 ZERO_FACS_MODEL_PATH（prosody 真、facs 仍占位）。权重须为默认架构（hidden=16, num_layers=1，
# 见 scripts/train_prosody.py）；形状不配对 load_state_dict fail-fast、文件不可读指向本 env fail-fast。
# ZERO_PROSODY_MODEL_PATH=artifacts/prosody_decoder.pt

# ── 真生理解码器注入（zero-link physiology 对称接线·2026-07-23；默认注释=占位路径零回归）──
# 设权重路径 → 工厂加载真 PhysiologyDecoder（WESAD 训练）注入 CompositeChannelDecoder 的 physiology
# 通道，physiology 出真信号 canonical {heart_rate_bpm[50,120], skin_conductance μS[0,20],
# temperature_c °C[30,40]}，供 MCP LinearPhysiologyMapper 按 μS/°C 归一。未设 → physiology 走解析
# 占位 {hr[70,110], skin_conductance[0,1], pupil_mm[3,5]}（零回归）。与 FACS/prosody 三通道独立门控：
# 可单独设本项而不设另两项。权重须为默认架构（hidden=16, num_layers=1，见 scripts/train_physiology.py）；
# 形状不配对 load_state_dict fail-fast、文件不可读指向本 env fail-fast。
# ZERO_PHYSIOLOGY_MODEL_PATH=artifacts/physiology_decoder.pt

# ── physiology 占位口径切换（议会 2026-07-23；默认注释/false=legacy 占位，零回归）──
# 与 ZERO_PHYSIOLOGY_MODEL_PATH 区别：
#   ZERO_PHYSIOLOGY_MODEL_PATH  → 注入真 WESAD 权重模型，physiology 走真网络推理。
#   ZERO_PHYSIOLOGY_CANONICAL_PLACEHOLDER → 切换解析占位口径（无真模型时的 fallback 公式）：
#     false（默认）= legacy 占位 {hr[70,110] bpm / sc[0,1] / pupil_mm[3,5]}，逐字零回归；
#     true = canonical 占位（议会签字公式）{hr[50,120] bpm / sc[0,20] μS / temperature_c[33,36]°C}，
#       量纲与真 PhysiologyDecoder 同口径（可对接 MCP LinearPhysiologyMapper）。
# 两者可组合：同时设 MODEL_PATH + CANONICAL_PLACEHOLDER=true → 真模型优先（占位不生效）。
# MCP 收窄耦合：MCP 消费方依赖 canonical 键集（hr/sc μS/temperature_c）须确认部署端已开此门；
#   默认关→ MCP 收到 legacy 键集（含 pupil_mm），消费方不得假定两路径键集相同。
# sc 中立偏置注意：占位 arousal=0 → sc=0μS；真 decoder 中立态 ~10μS，系统性偏低 ~10μS；
#   占位与真 decoder 路径禁止跨路径绝对比较（仅同路径内相对比较有意义）。
# ZERO_PHYSIOLOGY_CANONICAL_PLACEHOLDER=false

# ── 精度旋钮（默认注释=用内置常量，行为不变）──
# ZERO_MOOD_PRECISION=0.8                        # mood 流精度加权
# ZERO_TEXT_AFFECT_PRECISION=0.3                 # 文本语义流精度

# ── 层级预测编码 HPC（默认注释=平层，行为不变）──
# ZERO_HPC_LAYERS=2                              # 层数 1-2（1=平层=默认行为）
# ZERO_HPC_COUPLING=0.5                          # 层间耦合 w∈[0,1]（0=退平层）

# ── HPA / 皮质醇慢回路（默认全注释=关，行为不变）──
# ZERO_CORTISOL_ENABLED=1                        # 总门控
# ZERO_CORTISOL_AROUSAL_GATE=1                   # cortisol→arousal 基线抬升子门
# ZERO_CORTISOL_ATTITUDE_GATE=1                  # cortisol→ATTITUDE_RATE 放大子门
# ZERO_CORTISOL_TAU=5400                         # 衰减时间常数（秒）
# ZERO_CORTISOL_IMPULSE=0.7                      # 单次应激脉冲注入量
# ZERO_CORTISOL_AROUSAL_ALPHA=0.15               # cortisol→arousal 系数
# ZERO_CORTISOL_ATTITUDE_ALPHA=0.5               # cortisol→ATTITUDE_RATE 系数
# ZERO_CORTISOL_THETA_GOAL=0.3                   # 触发判据：目标不一致阈值
# ZERO_CORTISOL_THETA_INTENSITY=0.5              # 触发判据：强度阈值

# ── ToM / 社会情绪共情（默认全注释=关，行为不变）──
# ZERO_CONTAGION_ALPHA=0.15                      # 情绪传染系数
# ZERO_CARE_BIAS_ALPHA=0.2                       # CARE 先验抬高系数
# ZERO_VICARIOUS_ALPHA=0.1                       # 替代喜悦系数
# ZERO_VICARIOUS_THRESHOLD=0.3                   # 替代喜悦触发阈

# ── 日志 ──
ZERO_CONVERSATION_LOG=1                          # 每轮对话落人读日志；设 0 关
ZERO_LOG_DIR=logs                                # 日志目录
# ZERO_LOG_LEVEL=INFO                            # 日志级别；排障设 DEBUG

# —— 外部多模态先验流注入口（议会 2026-07-15 M1–M6；默认全注释=关，行为不变）——
# Zero 侧校验参数（M3/M6）：精度上界 + 流数上界
# ZERO_EXTERNAL_PRIOR_PRECISION_CAP=0.8     # 单条外部先验精度上界；超出 fail-fast（默认 0.8，与代码 getenv 默认一致=零回归）
# ZERO_MAX_EXTERNAL_STREAMS=5               # 每轮外部流数上界；超出 raise ValueError（默认 5·数学席 Σπ 虚增保险）
#
# MCP 感知侧参考默认（标注「MCP 决定给各模态盖多少精度」Zero 不应用只校验+M2强制）
# physio Piv 恒被 Zero 覆写 MIN_PRECISION（1e-3）：.env 旋钮仅记录推荐值、不实际放大效果
# 数值见 design.md §五表（受生物/心理/数学三席调和）
# EXTERNAL_FACE_PRECISION_V=0.20            # 视觉 face valence Piv；EmoNet CCC 0.90 较丰，保守取中
# EXTERNAL_FACE_PRECISION_A=0.12            # 视觉 face arousal Pia；CCC 0.80 稍低、AU 与唤醒对应弱于 valence
# EXTERNAL_AUDIO_PRECISION_V=0.10           # 语音 audio valence Piv；valence gap（F0/能量难区分正负），保守取低
# EXTERNAL_AUDIO_PRECISION_A=0.25           # 语音 audio arousal Pia；F0/能量=喉肌交感输出，信噪比高；低于 TEXT_AFFECT 0.3 保层级
# EXTERNAL_PHYSIO_PRECISION_V=0.001         # 生理 physio valence Piv；强制=MIN_PRECISION(1e-3)；EDA/HRV/瞳孔对效价盲
# EXTERNAL_PHYSIO_PRECISION_A=0.18          # 生理 physio arousal Pia；交感唤醒较可靠；因共源 survival 默许保守取低

# —— zero-link MCP server（src/mcp_server；把 ConversationSession 包成 open/step/close 三工具供 MCP client 接）——
# 仅起 `python -m src.mcp_server` 时相关；`mcp` 走 optional-deps（默认不入 core）。
# ZERO_MCP_TRANSPORT=stdio                  # 传输：stdio（默认·本地子进程）/ http（streamable-http）
# ZERO_MCP_WORKSPACE_ENABLED=true           # 会话默认开 workspace（否则 external_priors 被整段跳过，见 affect_core）；MCP 边界让 client 传的先验生效
# ZERO_MCP_COPING_ENABLED=true              # 解锁 coping_potential（env 显式开·默认关·client override 不可翻·A5/A6 治理）
# ZERO_MCP_TEXT_COPING_ENABLED=true         # 解锁 text_coping（env 显式开·默认关·client override 不可翻·A5/A6 治理）
# ZERO_MCP_FEAR_DOMAIN_ENABLED=false        # MCP 边界 fear 域专属门（B1 BLOCK·默认关·client override 不可翻）
# 说明：三解锁门（COPING/TEXT_COPING/FEAR_DOMAIN）默认关（False）；需 env 显式设 true 才生效；client override 被治理静默忽略（A5·A6·B1）。
# HTTP（streamable-http）监听配置（仅 ZERO_MCP_TRANSPORT=http 生效；endpoint=http://host:port+path）：
# HTTP Bearer 鉴权（zero-link T5）：设 ZERO_MCP_HTTP_TOKEN 即对 /mcp 强制 Authorization: Bearer <token>，
#    缺/错回 401 结构化错误。loopback（127.0.0.1/::1/localhost）+ 未设 token = 免鉴权（本机·零回归）；
#    非 loopback（如 0.0.0.0 对外）+ 未设 token = 启动 fail-fast（拒开无鉴权裸端口）。两侧 .env 共享同一
#    token（MCP 侧 ZERO_HTTP_TOKEN ↔ 本侧 ZERO_MCP_HTTP_TOKEN·映射同值）；固定 token 即可（勿提交）。
# ZERO_MCP_HTTP_HOST=127.0.0.1              # 监听地址（仅本机；远程暴露设 0.0.0.0，须配 token 否则启动 fail-fast）
# ZERO_MCP_HTTP_PORT=8000                   # 监听端口
# ZERO_MCP_HTTP_PATH=/mcp                   # streamable-http 路径（client endpoint = host:port + 此路径）
# ZERO_MCP_HTTP_TOKEN=                      # 共享 Bearer 密钥（纯 ASCII·如 hex/UUID/base64·走 .env 勿提交）；空/纯空白=等同未设（本机免鉴权·对外启动 fail-fast）
# 复用旋钮：ZERO_CHECKPOINT_BACKEND（会话态持久：memory 默认 / sqlite 跨重启）·
#   ZERO_EXTERNAL_PRIOR_PRECISION_CAP · ZERO_MAX_EXTERNAL_STREAMS（同上·M3/M6 校验）·
#   ZERO_FACS_MODEL_PATH + ZERO_FACS_EXTENDED（设了注入真 13-AU 解码器 → facs_au 出全 13 键）·
#   ZERO_PROSODY_MODEL_PATH（设了注入真 ProsodyDecoder → prosody_scale 翻 normalized·见上文韵律块；
#     未设则 prosody_scale 仍 ratio）·
#   ZERO_PHYSIOLOGY_MODEL_PATH（设了注入真 PhysiologyDecoder → physiology 出 WESAD {hr,sc(μS),
#     temperature_c}·见上文生理块；未设则 physiology 走解析占位 {hr,sc[0,1],pupil_mm}）。
# 会话跨重启持久（zero-link T6）：默认 memory 后端 server 重启即丢会话。要跨重启续会话须设
#   ZERO_CHECKPOINT_BACKEND=sqlite（+ZERO_CHECKPOINT_DB 路径）；client 重启后用**同一 session_id**
#   调 zero.open_session(session_id=旧, config=同) 即重开续上运行态（memory 后端重开=全新会话）。
#   未知/过期 session_id 时 zero.step 回 "unknown-session:" 前缀的 ToolError（isError），
#   client 据此机读标记触发同 id 重开重试。⚠ session_id 由 client 自持=运行态访问凭据：
#   任意 client 用他人 session_id 即可 resume 到其运行态/记忆；单机单用户安全，多用户须鉴权。

# —— 记忆巩固与遗忘（B 类·2026-07-22；默认全注释=关，行为不变）——
# 主门：0=关（整体 no-op·零回归）；设 1 后会话结束 aclose 触发 Ebbinghaus 衰减+睡眠巩固迁移。
# 生物近似声明：巩固触发=生物睡眠周期工程近似（实际跨天至周·Davis&Zhong 2017）；
#   分层幂律=系统巩固快/慢双阶段工程代理（非完整 MCM 4 参数模型）。
# ZERO_CONSOLIDATION_ENABLED=0            # 巩固主门（默认关=零回归）
#
# Ebbinghaus 分层幂律衰减（decay_weight；不物理删·_trim_capacity 按 decay_weight 优先驱逐）
# ZERO_CONSOLIDATION_D_SESSION=0.8        # SESSION scope 幂律指数（快衰·对应海马快速存储）
# ZERO_CONSOLIDATION_D_USER=0.3           # USER scope 幂律指数（慢衰·对应新皮层慢整合）
#
# 睡眠巩固迁移门（SESSION→USER 双准则·salience AND consolidation_count）
# ZERO_CONSOLIDATION_SALIENCE_THRESHOLD=0.25 # salience 升迁门（Hill 归一后·对应 precision≈30 实测中线·议会 2026-07-22）
# ZERO_CONSOLIDATION_COUNT_MIN=3          # 最低强化次数门（≥此值才候选升迁）
# ZERO_CONSOLIDATION_TIMEOUT=30.0         # aclose 巩固超时秒（超时降级 warning 不崩）
#
# ACT-R 频率门（Petrov 2006 B 近似替换召回 recency 项·默认关=幂律 Δt^(-d)·零回归）
# ZERO_ACTR_ENABLED=0                     # ACT-R recency 替换门（默认关=零回归）
# ZERO_ACTR_B_SCALE=3.0                   # Petrov B sigmoid 归一 scale（越小频率效应越激进）
