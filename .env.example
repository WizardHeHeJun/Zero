# Zero 环境变量样例（复制为 .env 后按需改）。每个变量只给一行功能速记；
# 默认值 / 取值范围 / 推荐值 / 陷阱 / 依据一律见 README「配置（.env）」。
# ⚠ 整份粘贴后须改 ZERO_OPENAI_API_KEY 与 ZERO_OPENAI_MODEL 两行。
# ⚠ 每个 KEY 只写一行（重复时后者生效）。

# ── 运行后端 ──
# ZERO_CHECKPOINT_BACKEND=memory                 # 运行态后端：memory / sqlite
ZERO_CHECKPOINT_DB=data/checkpoints.sqlite3     # sqlite 后端库文件路径
# ZERO_PG_DSN=postgresql://postgres:postgres@localhost:5432/zero  # postgres 接线后才读
# ZERO_MEMORY_BACKEND=memory                     # 长期记忆图谱：memory / sqlite / neo4j
ZERO_GRAPH_DB=data/graph.sqlite3                # sqlite 图谱库文件路径
ZERO_NEO4J_URI=bolt://localhost:7687            # neo4j 连接 URI
ZERO_NEO4J_USER=neo4j                           # neo4j 用户名
ZERO_NEO4J_PASSWORD=password                    # neo4j 密码

# ── LLM（OpenAI 兼容）──
ZERO_OPENAI_API_KEY=sk-your-key-here            # 必填：API key
ZERO_OPENAI_MODEL=qwen-flash                    # 必填：key 有权限的真实模型 id
ZERO_OPENAI_BASE_URL=https://api.openai.com/v1  # 可选：接口地址

# ── 语义记忆侧信道（向量召回）──
ZERO_SEMANTIC_BACKEND=sqlite_vec                # 留空=关 / sqlite_vec / graphiti
ZERO_SEMANTIC_DB=data/semantic.sqlite3          # sqlite_vec 落盘路径
ZERO_GRAPHITI_EMBED_MODEL=gemini-embedding-001  # 向量嵌入模型
ZERO_GRAPHITI_MODEL=deepseek-v4-pro             # graphiti 抽取用 LLM
ZERO_GRAPHITI_DB=neo4j                          # graphiti 图库

# ── 文本情感回归（输入侧）──
ZERO_TEXT_AFFECT_BACKEND=st                     # 输入侧文本情感回归后端
ZERO_TEXT_AFFECT_MODEL_PATH=artifacts/text_affect_regressor_st.pt  # 回归头权重路径

# ══ 可选旋钮：注释 = 用内置默认；取消注释才覆盖 ══

# ── 数字人对话：人格 + 情绪读出/修复 ──
ZERO_PERSONA_FILE=personas/persona.json         # 人格卡文件路径
ZERO_AFFECT_READOUT=map                         # 情绪读出：map=后验均值 / sample=采样
ZERO_APPRAISE_CALIBRATE=1                       # 评价标定，抵消 LLM 正向偏置
ZERO_EMOTION_NOISE_STD=0.05                     # 情绪噪声幅度（0=关）
ZERO_EMOTION_BASELINE_ATTITUDE_W=0.6            # 情绪回落基线里 attitude 占比
# ZERO_TEMPER_VALENCE_GATE=-0.15                 # 脾气段仅在情绪负到此值才注入；未设=无条件
# ZERO_FACTUAL_MODE=1                            # 事实化：不捏造身份/日期/往事，情绪保留；空/0=关
# ZERO_PUSH_NEUTRAL_DEADZONE=1                   # 情绪趋零轮不注入用词倾向；空/0=关；事实化开时自动生效
# ZERO_SAMPLE_SIGMA_MAX=0.5                      # 采样抖动上限（仅 sample 读出）
# ZERO_CHAT_RNG_SEED=42                          # 固定随机种子（eval 复现）

# ── 数字人对话：治「越聊越暧昧」──
ZERO_INTENSITY_FLOOR=0                          # arousal 强度下限
ZERO_AROUSAL_BASELINE=-0.08                     # arousal 基准平移
ZERO_ATTITUDE_REVERSION_A=0.4                   # 态度 arousal 维回归率
ZERO_ATTITUDE_SETPOINT_A=0.0                    # 态度 arousal 回归锚
ZERO_HABITUATION_TAU=7                          # 习惯化 τ(轮)；0=关

# ── 数字人对话：防关系无端升温 ──
ZERO_AROUSAL_GAIN_CAP=0.5                       # arousal_gain 上限；空=不 cap
ZERO_ATTITUDE_RATE_DECAY_K=0.8                  # 越熟态度形成越慢；0=关
ZERO_FAMILIARITY_TAU=20                         # 熟悉度累积 τ(轮)
ZERO_RELATIONSHIP_STAGE_HINT=1                  # 关系距离软提示；空/0=关

# ── 记忆：注意力窗 + 召回排序 ──
ZERO_HISTORY_WINDOW=40                          # 工作记忆窗总条数
ZERO_HISTORY_PRIMACY_K=5                        # 窗内首因保留条数
ZERO_RECALL_INJECT_MIN=0.5                      # 召回升入注意力预算的重要性门
ZERO_RECALL_SIM_MIN=0.65                        # 召回余弦相似度下限
ZERO_RECALL_DECAY_D=0.5                         # recency 幂律指数 d
ZERO_RECALL_ALPHA=0.33                          # 三维重排权重：recency
ZERO_RECALL_BETA=0.34                           # 三维重排权重：sim
ZERO_RECALL_GAMMA=0.33                          # 三维重排权重：importance
ZERO_RECALL_IMPORTANCE_SCALE=30                 # importance 归一 Hill 常数 C
ZERO_RECALL_AROUSAL_MOD=0                       # 唤醒调制召回 importance（1 开启）
ZERO_EPISODE_MAX_PER_KEY=300                    # 单人情景上限（0=不限）
ZERO_EPISODE_SALIENCE_MIN=0.15                  # 情景写入显著度门
ZERO_EPISODE_SALIENCE_AFFECTIVE_ADD=0           # 低唤醒高语义补偿（1 开启）
ZERO_EPISODE_DEDUP_MAX=0.92                     # 情景写入去重余弦阈
ZERO_IDENTITY_FACT_BYPASS=1                     # 身份自陈（姓名/职业）绕过显著度门写入；设 0 关
ZERO_WRITE_GATE_INFORMATIVE=1                   # LLM 判定「含独立事实性命题」时也写入

# ── workspace 精度重构（默认关）──
# ZERO_PRECISION_SPLIT=1                         # value 流精度消 β·V 混同
# ZERO_FUSE_INDEPENDENCE_CORRECT=1               # 防共线过度自信
# ZERO_IGNITION_SURVIVAL_FALLBACK=1              # 全弱刺激时 survival 流兜底广播
# ZERO_IGNITION_BETA=20                          # ignite 软门控陡度 β

# ── va_coupling 非对称（默认对称）──
# ZERO_VA_COUPLING_POS=0.5                       # 正效价侧 V-A 耦合系数
# ZERO_VA_COUPLING_NEG=0.7                       # 负效价侧 V-A 耦合系数

# ── 两时间尺度补充（默认关）──
# ZERO_ATTITUDE_AROUSAL_WEIGHT=0.0               # 高唤醒放大态度累积率；0=关
# ZERO_HABITUATION_SENSITIZATION_GAIN=0.0        # 敏化增益；0=纯习惯化
# ZERO_SENSITIZATION_THRESHOLD=0.5               # 敏化激活阈

# ── OCC 评价补充（默认关）──
# ZERO_STANDARD_COMPLIANCE=1                     # 词典桥读社会规范违反/遵从

# ── Panksepp RAGE/FEAR 次级区分（缺依据，建议保持关闭）──
# ZERO_PANKSEPP_DISTINGUISH_FEAR=1               # (-v,+a) 象限按 arousal 阈值分 fear/rage

# ── 情感第三维 coping_potential ──
ZERO_COPING_POTENTIAL_ENABLED=true              # 应对潜能标量流总开关
# ZERO_FEAR_DOMAIN_ENABLED=false                 # 恐惧域总开关
ZERO_TEXT_DOMAIN_ENABLED=true                   # 对话每轮注入语境（对抗/中性）
ZERO_TEXT_COPING_ENABLED=true                   # 从文本推 coping 方向先验
ZERO_TEXT_COPING_PRECISION=0.08                 # 文本 coping 先验精度
ZERO_DIRECTION_HEAD_MODEL_PATH=artifacts/motivational_direction_prior_m.pt  # 方向头权重
# ZERO_ANGER_ABSTAIN_LOGIT_THRESHOLD=0.0         # 方向头弃权阈（0=不弃权）

# ── 真通道解码器注入 ──
ZERO_FACS_EXTENDED=true                         # 表情改用 13-AU 扩展集
ZERO_FACS_MODEL_PATH=artifacts/facs_decoder_ext_v2.pt  # 表情通道真权重路径
# ZERO_FACS_K_AROUSAL=1.5                        # AU 映射唤醒幅度系数
# ZERO_FACS_K_COPING=1.2                         # AU 映射 coping 幅度系数
# ZERO_FACS_RESIDUAL_ALPHA=1.0                   # 判别 AU 中占位规则 vs 真模型的混合比
ZERO_VOLUNTARY_COPING_LEAK=0.3                  # 随意表情对 coping 驱动 AU 的保留比例
ZERO_PROSODY_MODEL_PATH=artifacts/prosody_decoder.pt      # 韵律通道真权重路径
ZERO_PHYSIOLOGY_MODEL_PATH=artifacts/physiology_decoder.pt # 生理通道真权重路径
# ZERO_PHYSIOLOGY_CANONICAL_PLACEHOLDER=false    # 无真模型时生理占位切 canonical 量纲

# ── 动作层（默认关=零回归）──
# ZERO_MOTION_ENABLED=false                      # MCP 工具 zero.motion 的总开关
# ZERO_MOTION_BACKEND=synth                      # synth=拉取侧现算（默认）/ directive=图内决策 / efference=再留指令副本
# ZERO_BEHAVIOR_FEEDBACK=false                   # 行为反馈流总门（需 efference+调节触发+非默认硬门才生效，默认关）

# ── 表现层出口（对话情绪 → 外部表现形式；默认关=零回归）──
# ZERO_VTS_SINK=false                            # 皮套出口：对话时 Live2D 形象跟着情绪动
# ZERO_REGULATION_ENABLED=false                  # 双通路调节（自发 vs 随意），开后表现层可用随意通路
# ZERO_VTS_MCP_REPO=../Zero_MCP                  # 渲染端仓路径（默认取本仓兄弟目录）
# ZERO_VTS_TOKEN_FILE=data/steering/motion/vts_token  # 皮套授权 token 落盘位置

# ── 精度旋钮（默认用内置常量）──
# ZERO_MOOD_PRECISION=0.8                        # mood 流精度加权
# ZERO_TEXT_AFFECT_PRECISION=0.3                 # 文本语义流精度

# ── 精度量纲齐次化（默认关）──
# ZERO_PRECISION_COMMENSURABLE=false             # 四条并行流精度统一成 1/σ²

# ── 硬门摘出数值通路（⚠ 方向与其它旋钮相反）──
# ZERO_IGNITION_GATE_FUSION=true                 # 设 false 才启用全流按精度加权的新后验
# ZERO_EXCLUDE_PHYSIO_FUSION=true                # physio 流不进数值通路

# ── 层级预测编码 HPC（默认平层）──
# ZERO_HPC_LAYERS=2                              # 层数 1-2（1=平层）
# ZERO_HPC_COUPLING=0.5                          # 层间耦合 w∈[0,1]

# ── HPA / 皮质醇慢回路（默认关）──
# ZERO_CORTISOL_ENABLED=1                        # 总门控
# ZERO_CORTISOL_AROUSAL_GATE=1                   # cortisol→arousal 基线抬升子门
# ZERO_CORTISOL_ATTITUDE_GATE=1                  # cortisol→态度累积率放大子门
# ZERO_CORTISOL_TAU=5400                         # 衰减时间常数（秒）
# ZERO_CORTISOL_IMPULSE=0.7                      # 单次应激脉冲注入量
# ZERO_CORTISOL_AROUSAL_ALPHA=0.15               # cortisol→arousal 系数
# ZERO_CORTISOL_ATTITUDE_ALPHA=0.5               # cortisol→态度累积率系数
# ZERO_CORTISOL_THETA_GOAL=0.3                   # 触发判据：目标不一致阈值
# ZERO_CORTISOL_THETA_INTENSITY=0.5              # 触发判据：强度阈值

# ── ToM / 社会情绪共情（默认关）──
# ZERO_CONTAGION_ALPHA=0.15                      # 情绪传染系数
# ZERO_CARE_BIAS_ALPHA=0.2                       # CARE 先验抬高系数
# ZERO_VICARIOUS_ALPHA=0.1                       # 替代喜悦系数
# ZERO_VICARIOUS_THRESHOLD=0.3                   # 替代喜悦触发阈

# ── 记忆巩固与遗忘 ──
ZERO_CONSOLIDATION_ENABLED=0                    # 记忆衰减批处理门
ZERO_CONSOLIDATION_D_USER=0.3                   # 长期分层幂律衰减指数
ZERO_CONSOLIDATION_TIMEOUT=30.0                 # 会话结束巩固超时秒
# ZERO_ACTR_ENABLED=0                            # 用 ACT-R 频率激活替换召回新近项
# ZERO_ACTR_B_SCALE=3.0                          # 频率归一尺度
# ZERO_RECALL_SALIENCE_DECAY=0                   # 让显著度调制召回新近项的衰减速率
# ZERO_RECALL_SALIENCE_KAPPA=1.0                 # 上述调制强度：衰减指数最多缩到 1/(1+κ)
ZERO_TAG_IMPORTANCE=1                           # 重要性=语义标签折入情绪精度共同重排
# ZERO_CONSOLIDATION_D_SESSION=0.8               # 短期分层幂律衰减指数

# ── 外部多模态先验流注入口（默认关）──
# ZERO_EXTERNAL_PRIOR_PRECISION_CAP=0.8          # 单条外部先验精度上界
# ZERO_MAX_EXTERNAL_STREAMS=5                    # 每轮外部流数上界
# EXTERNAL_FACE_PRECISION_V=0.20                 # 视觉面部先验精度：效价
# EXTERNAL_FACE_PRECISION_A=0.12                 # 视觉面部先验精度：唤醒
# EXTERNAL_AUDIO_PRECISION_V=0.10                # 语音韵律先验精度：效价
# EXTERNAL_AUDIO_PRECISION_A=0.25                # 语音韵律先验精度：唤醒
# EXTERNAL_PHYSIO_PRECISION_V=0.001              # 生理先验精度：效价
# EXTERNAL_PHYSIO_PRECISION_A=0.18               # 生理先验精度：唤醒

# ── zero-link MCP server（python -m src.mcp_server，需 mcp extra）──
# ZERO_MCP_TRANSPORT=stdio                       # 传输：stdio / http
# ZERO_MCP_HTTP_HOST=127.0.0.1                   # HTTP 监听地址
# ZERO_MCP_HTTP_PORT=8000                        # HTTP 监听端口
# ZERO_MCP_HTTP_PATH=/mcp                        # HTTP 路径
# ZERO_MCP_HTTP_TOKEN=                           # Bearer 共享密钥（勿提交）
# ZERO_MCP_WORKSPACE_ENABLED=true                # 会话默认开工作空间
# ZERO_MCP_COPING_ENABLED=false                  # 边界侧 coping_potential
# ZERO_MCP_TEXT_COPING_ENABLED=false             # 边界侧文本 coping
# ZERO_MCP_FEAR_DOMAIN_ENABLED=false             # 边界侧恐惧域开关
# ZERO_MCP_PRECISION_COMMENSURABLE=false         # 边界侧精度齐次化
# ZERO_MCP_IGNITION_GATE_FUSION=true             # 边界侧硬门开关
# ZERO_MCP_EXCLUDE_PHYSIO_FUSION=true            # 边界侧 physio 排除
# ZERO_MCP_IGNITION_BETA=                        # 边界侧软门陡度；留空=硬门
# ZERO_MCP_STEP_LOCK_TIMEOUT=                    # step 等会话锁的超时秒；留空=无限等待

# ── 日志 ──
ZERO_CONVERSATION_LOG=1                         # 每轮对话落人读日志；设 0 关
ZERO_LOG_DIR=logs                               # 日志目录
# ZERO_LOG_LEVEL=INFO                            # 日志级别；排障设 DEBUG
# ZERO_LOG_CONSOLE=1                             # 日志同时打控制台；设 0 只落文件
# ZERO_LOG_CONSOLE_PLAIN=1                       # 控制台用极简格式
