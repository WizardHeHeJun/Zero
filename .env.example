# 情感表达系统 — 环境变量样例（容器/本地）。复制为 .env 后按需修改。
# 默认（不设任何变量）= 全内存占位，零依赖可跑；设下列变量即切本地落盘/真后端。
# 两个维度互相独立：运行态 Checkpointer 与 长期记忆 各自选后端，可任意组合。
# ⚠ 每个 KEY 只能出现一次！别在多处重复定义（dotenv 后者覆盖前者，易踩坑）。

# 运行态 Checkpointer 后端：memory（默认）/ sqlite / postgres
ZERO_CHECKPOINT_BACKEND=memory
ZERO_CHECKPOINT_DB=data/checkpoints.sqlite3
ZERO_PG_DSN=postgresql://postgres:postgres@localhost:5432/zero

# 长期记忆图谱后端（确定性 (scope,key) 失效）：memory（默认）/ sqlite（落盘）/ neo4j（需 db extra）
ZERO_MEMORY_BACKEND=memory
ZERO_GRAPH_DB=data/graph.sqlite3

# 以下 3 个当 ZERO_MEMORY_BACKEND=neo4j 或 Graphiti 用 neo4j 图库时生效：
ZERO_NEO4J_URI=bolt://localhost:7687
ZERO_NEO4J_USER=neo4j
ZERO_NEO4J_PASSWORD=password

# ── OpenAI 兼容接口（语言层 + 语义记忆 embedding 共用，只配一处）──
# base_url 可指向 OpenAI / 本地 vLLM / Ollama / 第三方网关；留空则用 openai SDK 默认
ZERO_OPENAI_BASE_URL=https://api.openai.com/v1
ZERO_OPENAI_API_KEY=sk-your-key-here

# ── 语义记忆侧信道：Graphiti（深度集成，默认关）──
# 启用：取消下一行注释（设为 graphiti）；需装 graphiti extra：pip 
# ZERO_SEMANTIC_BACKEND=sqlite_vec

# 图库：neo4j（默认/生产，复用上面 ZERO_NEO4J_*）
ZERO_GRAPHITI_DB=neo4j

# 语言层（OpenAI 兼容）对话模型：① 按情绪生成回应 ② 独立再调一次给文本打 VAD。
# 必填，须是 key 有权限的真实模型 id（limited 是权限标签不是模型名，会 400；
# 可用 /v1/models 列出的，如 qwen-flash / deepseek-v4-flash / gpt-5.5 / claude-haiku-4-5@20251001）
ZERO_OPENAI_MODEL=qwen-flash

# 以下两项仅在开启「语义记忆侧信道」（ZERO_SEMANTIC_BACKEND=graphiti 或 sqlite_vec）时生效，默认关则不用
# Graphiti 抽取实体/关系入知识图谱用的 LLM（对话/推理模型）
ZERO_GRAPHITI_MODEL=deepseek-v4-pro
# 语义记忆的向量嵌入模型（sqlite_vec / graphiti 都用它做相似度召回），须是 embedding 模型
ZERO_GRAPHITI_EMBED_MODEL=gemini-embedding-001

# 文本情感回归（输入侧·默认关）：置 st 后必须同时提供权重路径
# ZERO_TEXT_AFFECT_BACKEND=st
# ZERO_TEXT_AFFECT_MODEL_PATH=artifacts/text_affect_regressor_st.pt

# ── 人格（--chat 数字人，默认两项都不设 = 中性无偏人格，逐字现有行为）──
# 给数字人「指定人格」，免去从零塑造一个人。两种入口（文件优先）：
# ① 仅人设卡（L1）快捷入口：身份/背景/口吻/与用户关系，注入对话 system prompt（单行文本）
# ZERO_PERSONA=你叫小津，是用户多年的老友，说话简短、爱用反问、刀子嘴豆腐心。
# ② 完整人格 JSON 文件（L1 人设卡 + L2 气质底色 + L3 预置关系），字段全可选：
# ZERO_PERSONA_FILE=data/persona.json
#   {
#     "name": "小津",
#     "card": "你叫小津，是用户多年的老友……",      // L1 人设卡
#     "setpoint": [0.1, -0.05],                      // L2 气质基线 (v,a)：略偏暖、偏平静
#     "reactivity": 0.6,                             // L2 对刺激的即时反应增益（↑≈神经质）
#     "recovery": 0.4,                               // L2 情绪恢复残留比例（↑=情绪退得慢）
#     "initial_attitude": [0.3, 0.1],                // L3 首次接触的初始态度（已经喜欢这个人）
#     "seed_memories": ["我们去年夏天一起去过青岛看海", "你不吃香菜"]  // L3 预灌的共同记忆
#   }
# 注：L2 的「大五→PAD 具体数值映射 / 预设人格库」属科学决策，须走 /science-council 设计门；
# 本接口只提供旋钮 + 中性默认，不替算法拍板具体性格参数。

# ── 注意力↔记忆桥 / 情绪稳态（均为默认值，取消注释可覆盖；设计依据见 PROGRESS.md 阶段25-26 + notes 议会纪要）──
# 仅 HISTORY_PRIMACY_K / HISTORY_WINDOW / EMOTION_BASELINE_ATTITUDE_W 默认改变 --chat 行为；其余默认零回归/关。
# U 形工作记忆窗：保留首 K 条（首因）+ 尾 (N-K) 条（近因）
# ZERO_HISTORY_PRIMACY_K=5
# ZERO_HISTORY_WINDOW=40
# 召回 episode 升入注意力预算竞争的归一 importance 门（∈[0,1]）
# ZERO_RECALL_INJECT_MIN=0.5
# 召回三维重排：recency 幂律指数 d + 权重 α/β/γ（recency / sim / importance）
# ZERO_RECALL_DECAY_D=0.5
# ZERO_RECALL_ALPHA=0.33
# ZERO_RECALL_BETA=0.34
# ZERO_RECALL_GAMMA=0.33
# importance 归一 Hill 常数 C：p/(p+C)，与 sim/recency 同量纲
# ZERO_RECALL_IMPORTANCE_SCALE=30
# 唤醒调制召回 importance（1 开启）
# ZERO_RECALL_AROUSAL_MOD=0
# 召回余弦相似度下限
# ZERO_RECALL_SIM_MIN=0.65
# episode 容量上限：同 (scope,key) 超量删最旧；0=不限（--chat 入口默认设 300）
# ZERO_EPISODE_MAX_PER_KEY=0
# episode 写入显著度门 salience=precision×|rpe|（承诺/日程类内容旁路强制写）
# ZERO_EPISODE_SALIENCE_MIN=0.15
# 低唤醒高语义补偿 salience+=0.3·|value|（1 开启）
# ZERO_EPISODE_SALIENCE_AFFECTIVE_ADD=0
# episode 写入去重余弦阈（高于此视为近义跳过）
# ZERO_EPISODE_DEDUP_MAX=0.92
# 情绪衰退基线 = w·attitude+(1-w)·中性；w<1 给情绪指向中性的回归力、防棘轮（w=1 退回旧纯 attitude 基线）
# 态度向中性的弱回归率是代码常量 affect_math.ATTITUDE_REVERSION=0.01（不走 env）
# ZERO_EMOTION_BASELINE_ATTITUDE_W=0.6
