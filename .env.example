# Zero 环境变量样例。复制为 .env 后按需改；每个变量的详细说明见 README「配置（.env）」一节。
# 不设任何变量 = 全内存占位、零依赖可跑。⚠ 每个 KEY 只能出现一次（dotenv 后者覆盖前者）。

# ── 运行后端（运行态 Checkpointer 与 长期记忆 各自独立选，可任意组合）──
ZERO_CHECKPOINT_BACKEND=memory                            # memory(默认) / sqlite / postgres
ZERO_CHECKPOINT_DB=data/checkpoints.sqlite3              # sqlite 后端库文件
ZERO_PG_DSN=postgresql://postgres:postgres@localhost:5432/zero  # postgres 后端 DSN
ZERO_MEMORY_BACKEND=memory                               # memory(默认) / sqlite(落盘) / neo4j(需 db extra)
ZERO_GRAPH_DB=data/graph.sqlite3                         # sqlite 图谱库文件
ZERO_NEO4J_URI=bolt://localhost:7687                     # 下面 3 项当 MEMORY=neo4j 或 Graphiti 用 neo4j 时生效
ZERO_NEO4J_USER=neo4j
ZERO_NEO4J_PASSWORD=password

# ── LLM（OpenAI 兼容；语言层 + 语义记忆 embedding 共用一处）──
ZERO_OPENAI_BASE_URL=https://api.openai.com/v1           # 可指向 OpenAI/vLLM/Ollama/网关，留空用 SDK 默认
ZERO_OPENAI_API_KEY=sk-your-key-here
ZERO_OPENAI_MODEL=qwen-flash                             # 必填，须是 key 有权限的真实模型 id

# ── 语义记忆侧信道（默认关）──
# ZERO_SEMANTIC_BACKEND=sqlite_vec                       # sqlite_vec(轻量) / graphiti(需 graphiti extra)
ZERO_GRAPHITI_DB=neo4j                                   # graphiti 图库，复用上面 NEO4J_*
ZERO_GRAPHITI_MODEL=deepseek-v4-pro                      # graphiti 抽取实体/关系的 LLM
ZERO_GRAPHITI_EMBED_MODEL=gemini-embedding-001           # 向量嵌入模型（须 embedding 模型）

# ── 文本情感回归（输入侧·默认关；置 st 须同时给权重路径）──
# ZERO_TEXT_AFFECT_BACKEND=st
# ZERO_TEXT_AFFECT_MODEL_PATH=artifacts/text_affect_regressor_st.pt

# ── 指定人格（--chat·默认都不设 = 中性无偏人格，逐字现有行为；文件优先）──
# ZERO_PERSONA=你叫小津，是用户多年的老友，说话简短、爱用反问。   # 仅 L1 人设卡（单行文本）
# ZERO_PERSONA_FILE=data/persona.json                    # 完整人格 JSON（L1+L2+L3，字段全可选，格式见 README）

# ── 对话行为微调旋钮（默认值，取消注释可覆盖；说明/设计依据见 README + PROGRESS 阶段25-26）──
# 仅 HISTORY_PRIMACY_K / HISTORY_WINDOW / EMOTION_BASELINE_ATTITUDE_W 默认改变 --chat 行为；其余默认零回归/关。
# ZERO_HISTORY_PRIMACY_K=5                # U 形窗保留的首因条数
# ZERO_HISTORY_WINDOW=40                  # 工作记忆窗总条数（首因 + 近因）
# ZERO_RECALL_INJECT_MIN=0.5             # 召回升入注意力预算的 importance 门 ∈[0,1]
# ZERO_RECALL_DECAY_D=0.5               # recency 幂律指数 d
# ZERO_RECALL_ALPHA=0.33               # 三维重排权重：recency
# ZERO_RECALL_BETA=0.34                # 三维重排权重：sim
# ZERO_RECALL_GAMMA=0.33               # 三维重排权重：importance
# ZERO_RECALL_IMPORTANCE_SCALE=30      # importance 归一 Hill 常数 C：p/(p+C)
# ZERO_RECALL_AROUSAL_MOD=0            # 唤醒调制召回 importance（1 开启）
# ZERO_RECALL_SIM_MIN=0.65            # 召回余弦相似度下限
# ZERO_EPISODE_MAX_PER_KEY=0           # 单 (scope,key) episode 上限，超量删最旧（0=不限；--chat 默认 300）
# ZERO_EPISODE_SALIENCE_MIN=0.15       # 写入显著度门 salience=precision×|rpe|（承诺/日程类旁路强写）
# ZERO_EPISODE_SALIENCE_AFFECTIVE_ADD=0  # 低唤醒高语义补偿 salience+=0.3·|value|（1 开启）
# ZERO_EPISODE_DEDUP_MAX=0.92          # 写入去重余弦阈（高于此视为近义跳过）
# ZERO_EMOTION_BASELINE_ATTITUDE_W=0.6   # 情绪衰退基线里 attitude 占比；<1 给回中性的拉力、防棘轮（1=旧行为）
